{
  "concurrency": 3,
  "max_rounds": 3,
  "checks_timeout_seconds": 1800,
  "base_branch": "main",
  "merge_method": "merge",
  "redo_stage": "build",
  "stages": [
    {"name": "intake", "agent": {"file": "intake.md"}, "input": ["issue.md", "intake-*.md", "feedback-*.md"], "output": "intake.md"},
    {"name": "spec", "agent": {"file": "spec-writer.md"}, "input": ["issue.md", "intake.md", "feedback-*.md"], "output": "spec.md"},
    {"name": "build", "agent": {"file": "builder.md"}, "input": ["spec.md", "issue.md", "intake.md", "round-{prev}/*", "feedback-*.md", "decision.md?"], "output": "build.md"},
    {"name": "gate", "script": "factory/bin/gate {job}", "output": "round-{round}/checks.md"},
    {"name": "review", "agents": {"routed": "reviewer-{agent}.md"}, "input": ["spec.md", "build.md", "round-{round}/checks.md", "round-*/review-{agent}.md"], "output": "round-{round}/review-{agent}.md"},
    {"name": "approve", "agent": {"file": "approver.md"}, "input": ["issue.md", "intake.md", "spec.md", "build.md", "feedback-*.md", "round-*/*.md"], "output": "decision.md"},
    {"name": "merging", "script": "factory/bin/job merge {job}", "output": "round-{round}/merge-checks.md"}
  ],
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low": {
      "code": "haiku"
    },
    "medium": {
      "code": "sonnet"
    },
    "high": {
      "code": "sonnet"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "sonnet",
      "ui": "haiku"
    },
    "security": {
      "security": "opus"
    }
  },
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    ".claude/agents/*",
    ".claude/skills/factory/*"
  ],
  "ports": {
    "base": 5100,
    "step": 10
  },
  "prices_usd_per_mtok": {
    "claude-fable-5-1": {"input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25},
    "claude-opus-5-5": {"input": 4.0, "output": 20.0, "cache_write_5m": 5.0, "cache_write_1h": 8.0, "cache_read": 0.2},
    "claude-sonnet-5-5": {"input": 2.0, "output": 10.0, "cache_write_5m": 2.5, "cache_write_1h": 4.0, "cache_read": 0.2},
    "claude-haiku-5-5": {"input": 0.1, "output": 0.5, "cache_write_5m": 0.125, "cache_write_1h": 0.2, "cache_read": 0.01}
  }
}
